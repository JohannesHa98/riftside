# Copy to .env inside /companion. Never commit the real file.

# Where the website lives. Use http://localhost:3000 to send to a dev server.
WEBSITE_URL=https://riftside.vercel.app

# Must match INGEST_SECRET on the website (.env.local and Vercel).
INGEST_SECRET=

# Only set this if League is installed somewhere other than the default.
