# Copy to .env.local and fill in. Never commit real values — .env* is gitignored.

# Neon Postgres, from the Vercel Marketplace integration.
DATABASE_URL=              # pooled, used by the app
DATABASE_URL_UNPOOLED=     # direct, used by drizzle-kit migrations

# Signs the session cookie. Generate 32+ random characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Rotating this signs every session out.
AUTH_SECRET=

# The one account. Generate with: npm run auth:hash
# Store the hash here, never the password itself.
ADMIN_PASSWORD_HASH=

# Shared with the companion app, which sends it as the x-ingest-secret header.
# Any long random string; the same value must sit in companion/.env.
INGEST_SECRET=
